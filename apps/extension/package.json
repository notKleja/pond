{
  "name": "@pond/extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Pond browser extension: capture saves from Twitter/X, Instagram, Pinterest, Are.na, Cosmos, TikTok, YouTube and any article into the local Pond library.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git",
    "directory": "apps/extension"
  },
  "scripts": {
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev": "wxt",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "@pond/schema": "workspace:*",
    "@pond/theme": "workspace:*",
    "@pond/ui": "workspace:*",
    "@webext-core/messaging": "^4.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wxt": "^0.21.4"
  }
}
